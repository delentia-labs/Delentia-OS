# Vector Search Service — Environment Configuration
# Copy this file to .env and fill in values for your environment

# ── Backend ────────────────────────────────────────────────────────────────
BACKEND=faiss                        # faiss | qdrant
DIMENSION=768                        # Embedding dimension (must match model output)

# ── FAISS backend ──────────────────────────────────────────────────────────
FAISS_INDEX_TYPE=flat                # flat | ivf | hnsw
FAISS_METRIC=cosine                  # cosine | l2 | ip
FAISS_NLIST=100
FAISS_M=32

# ── Qdrant backend ─────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=vectors
QDRANT_DISTANCE=cosine

# ── Intent Vector Extension (Phase 2) ──────────────────────────────────────
INTENT_VECTORS_COLLECTION=intent_vectors   # Separate collection for intent embeddings
INTENT_FDIA_INDEX_THRESHOLD=0.25           # Minimum FDIA score required to index a record
