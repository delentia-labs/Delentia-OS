# Delentia Desk — Environment Variables
# Copy to .env.local for local development

# Gateway URL for Delentia OS API (default: local dev server)
NEXT_PUBLIC_GATEWAY=http://localhost:8000

# API Key for /v1/* authenticated endpoints
# Obtain from: rct init → .env → RCT_CORE_BRAIN_KEY
# NEVER commit real keys to version control
NEXT_PUBLIC_API_KEY=

# App environment
NODE_ENV=development
