{
  "name": "delentia-gui",
  "version": "1.0.4",
  "private": true,
  "description": "Delentia Desk — Desktop GUI for Delentia OS (Intent-Centric AI)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "type-check": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --no-warnings src/lib/signed-decision.test.mjs",
    "test:run-state": "node --experimental-strip-types --no-warnings src/lib/run-state.test.mjs",
    "test:nav": "node --experimental-strip-types --no-warnings src/lib/nav-model.test.mjs",
    "test": "npm run test:unit && npm run test:run-state && npm run test:nav && npm run test:reason && npm run test:milestone && npm run test:webauthn && npm run test:readiness && npm run test:http && npm run test:fonts && npm run test:a11y",
    "test:reason": "node --experimental-strip-types --no-warnings src/lib/reason-text.test.mjs",
    "test:milestone": "node --experimental-strip-types --no-warnings src/lib/milestone.test.mjs",
    "test:readiness": "node --experimental-strip-types --no-warnings src/lib/readiness-text.test.mjs",
    "test:a11y": "node --experimental-strip-types --no-warnings src/lib/a11y-static.test.mjs",
    "test:http": "node --experimental-strip-types --no-warnings src/lib/http-message.test.mjs",
    "test:webauthn": "node --experimental-strip-types --no-warnings src/lib/webauthn.test.mjs",
    "test:fonts": "node --experimental-strip-types --no-warnings src/lib/fonts-bundle.test.mjs",
    "test:e2e": "node scripts/a11y-e2e.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/prompt": "^5.3.0",
    "@fontsource/sarabun": "^5.3.0",
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.441.0",
    "next": "16.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
