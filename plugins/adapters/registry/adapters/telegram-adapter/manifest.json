{
  "id": "telegram-adapter",
  "name": "Telegram Bot Adapter",
  "version": "1.0.0",
  "description": "Connects Telegram Bot API to Delentia OS via JITNA v3 intent routing. Supports text messages, commands, inline keyboards, and callback queries. Popular in developer communities and ASEAN/Eastern Europe markets.",
  "author": {
    "name": "Delentia Labs",
    "email": "infra@delentia.com",
    "url": "https://github.com/delentia-labs/delentia-ecosystem"
  },
  "jitna_channel": "telegram",
  "api_version": ">=2.0.0",
  "permissions": [
    "intent:read",
    "intent:execute",
    "network:outbound"
  ],
  "entry_point": "index.ts",
  "regional_support": ["GLOBAL"],
  "tags": ["messaging", "telegram", "bot", "developer", "community"],
  "security_scan_passed": true,
  "repository": "https://github.com/delentia-labs/delentia-ecosystem",
  "license": "Apache-2.0",
  "env_required": [
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_WEBHOOK_SECRET",
    "DELENTIA_GATEWAY",
    "DELENTIA_API_KEY"
  ]
}
