# Delentia Infrastructure — Community Environment Variables
# Copy to .env and fill in all values before running docker-compose

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Required: a strong random password (min 24 chars)
POSTGRES_PASSWORD=changeme_replace_with_strong_secret

# ── Delentia API Key ─────────────────────────────────────────────────────────
# Generated on first install by scripts/install.sh
# Used by Gateway API for Bearer token validation
DELENTIA_API_KEY=

# ── Delentia OS Environment ──────────────────────────────────────────────────
DELENTIA_ENV=production

# ── OpenRouter API Key (optional — for HexaCore cloud models) ───────────────
# If left empty, only OLLAMA_ADAPTER (local) is available
OPENROUTER_API_KEY=

# ── Anthropic API Key (optional — for SUPREME_ARCHITECT role) ───────────────
ANTHROPIC_API_KEY=
